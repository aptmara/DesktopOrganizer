<Window x:Class="DesktopOrganizer.UI.Controls.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename Shelf" Height="140" Width="300"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    
    <Border CornerRadius="8" BorderBrush="#44FFFFFF" BorderThickness="1" Background="#CC202020">
        <StackPanel Margin="16">
            <TextBlock Text="Rename Shelf" Foreground="White" FontWeight="Bold" Margin="0,0,0,12"/>
            <TextBox x:Name="NameTextBox" Height="28" Background="#20FFFFFF" Foreground="White" BorderThickness="0" 
                     VerticalContentAlignment="Center" Padding="4,0" CaretBrush="White"/>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Width="70" Height="26" Margin="0,0,8,0" Click="Cancel_Click"
                        Background="Transparent" Foreground="#AAAAAA" BorderThickness="0"/>
                <Button Content="OK" Width="70" Height="26" Click="OK_Click"
                        Background="#40000000" Foreground="White" BorderBrush="#44FFFFFF" BorderThickness="1"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
