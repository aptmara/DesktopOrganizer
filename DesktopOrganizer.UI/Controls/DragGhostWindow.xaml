<Window x:Class="DesktopOrganizer.UI.Controls.DragGhostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DragGhostWindow" Height="300" Width="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" IsHitTestVisible="False"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Rectangle x:Name="GhostVisual" Opacity="0.7">
            <Rectangle.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="5" Opacity="0.5"/>
            </Rectangle.Effect>
        </Rectangle>
    </Grid>
</Window>
