<Window x:Class="DesktopOrganizer.UI.Controls.FilterSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="フィルタ設定" Height="250" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <!-- Re-use simple styles if needed, or rely on App.xaml -->
        <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}"/>
        <Style TargetType="TextBox">
             <Setter Property="Padding" Value="4"/>
             <Setter Property="Background" Value="#33000000"/>
             <Setter Property="Foreground" Value="White"/>
             <Setter Property="BorderThickness" Value="1"/>
             <Setter Property="BorderBrush" Value="#44FFFFFF"/>
             <Setter Property="CaretBrush" Value="White"/>
        </Style>
    </Window.Resources>
    
    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="表示するファイルの種類を設定" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

            <TextBlock Grid.Row="1" Text="フィルタパターン (例: *.jpg;*.png)" Margin="0,0,0,5" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox Grid.Row="2" x:Name="PatternTextBox" VerticalAlignment="Top"/>
            
            <TextBlock Grid.Row="2" Margin="0,35,0,0" Text="※ 空欄または *.* で全てのファイルを表示します。" 
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="キャンセル" IsCancel="True" Width="80" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button Content="OK" IsDefault="True" Width="80" Click="OK_Click" Background="{StaticResource BrandPrimaryBrush}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
